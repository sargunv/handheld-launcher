amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"

steps {
  ["dprint"] = Builtins.dprint
  ["jactionlint"] = Builtins.jactionlint
  ["shellcheck"] = Builtins.shellcheck
  ["cargo-clippy"] {
    glob = List("**/*.rs")
    check = "cargo clippy --workspace --all-targets --all-features -- -D warnings"
    fix = "cargo clippy --workspace --all-targets --all-features --fix --allow-dirty --allow-staged"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    // Several worktrees and sessions share this repo's stash stack, so the hook
    // never stashes.
    stash = "none"
  }
}
