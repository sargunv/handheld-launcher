<?xml version="1.0" encoding="utf-8"?>
<!-- The RomM server is whatever address the user signs in to, and some run plain HTTP on a private
     network or a tailnet, so cleartext is allowed to any host. Sign-in says when a server isn't
     encrypted. Debug builds also reach a test server on the development machine through
     adb reverse, at http://localhost. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
  <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
