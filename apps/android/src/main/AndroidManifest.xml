<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- RomM sign-in and sync. OkHttp declares it too, but the app shouldn't rely on that. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Games live in shared storage, such as /storage/emulated/0/ROMs, where an app reads only its
       own files without this. The launcher reads them to hand them to emulators. -->
  <uses-permission
    android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
    tools:ignore="ScopedStorage" />

  <!-- Downloads go on in the background in a foreground service, which shows their progress in a
       notification. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Any installed app can run a game, so the launcher sees every app with a launcher icon. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application android:label="Handheld" android:theme="@android:style/Theme.Material.NoActionBar">
    <!-- Compose handles configuration changes itself. Without these, connecting a gamepad
         (keyboard, navigation) or changing the screen recreates the activity, and stops a game
         running in it. -->
    <activity
      android:name=".MainActivity"
      android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode"
      android:exported="true"
      android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <service
      android:name=".DownloadService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.launch"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/launch_files" />
    </provider>
  </application>
</manifest>
